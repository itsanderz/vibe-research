{
	"name": "vibe-research",
	"version": "0.1.0",
	"description": "vibe CLI - fork identity wrapper around @earendil-works/pi-coding-agent for the vibe-research project",
	"type": "module",
	"bin": {
		"vibe": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
